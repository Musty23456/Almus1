# ===== ALMUS CHAT — Environment Variables =====
# Copy this file to backend/.env and fill in real values.
# NEVER commit the real .env file.

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgresql://almus:almus_password@localhost:5432/almus_chat?schema=public

# JWT secrets - generate strong random values, e.g.:
#   openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=30

# Uploads
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=uploads

# Object storage (optional; leave blank to use local disk storage in dev)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Push notifications (Firebase Cloud Messaging)
FCM_SERVER_KEY=
